# Server
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# Session
SESSION_SECRET=gerar-com-crypto-randomBytes-64-aqui

# Admin (seed inicial)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trocar-na-primeira-vez

# Rate Limiting
MAX_PASSWORD_ATTEMPTS=5
PASSWORD_ATTEMPT_WINDOW_MINUTES=1

# Viewer Session
VIEWER_SESSION_MAX_AGE_HOURS=2

# Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Carregamento progressivo (requer qpdf no servidor)
PDF_FIRST_BLOCK_PAGES=5
PDF_BLOCK_PAGES=20
# QPDF_BIN=/caminho/para/qpdf

# PDFs identificados por acesso: cache por documento (originais preservados)
ACCESS_PDF_CACHE_MB=1024
ACCESS_PDF_CACHE_HOURS=6

# Piloto interno por imagens (apenas no painel; requer poppler-utils)
IMAGE_PREVIEW_CACHE_MB=1024
# PDFTOPPM_BIN=/caminho/para/pdftoppm

# Preparação persistente em segundo plano (processo separado, baixa prioridade)
IMAGE_PREPARATION_ENABLED=true
IMAGE_PREPARATION_MIN_FREE_MB=2048
# Muda para imagens automaticamente apenas quando todo o acesso estiver pronto.
# false mantém os clientes no PDF e permite testar imagens no painel.
IMAGE_VIEWER_ENABLED=true

# Entrega opcional por Worker + R2 privado. Configure TODAS as seis variáveis.
# MEDIA_EDGE_URL=https://media-lookbook.charth.cloud
# MEDIA_EDGE_SECRET=segredo-aleatorio-de-no-minimo-32-caracteres
# R2_ACCOUNT_ID=
# R2_BUCKET=charth-lookbook-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
