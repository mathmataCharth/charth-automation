<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= doc.title %> | SecureView Charth</title>
    <link rel="icon" href="https://charth.vteximg.com.br/arquivos/favicon.ico">
    <link rel="stylesheet" href="/public/shared/css/base.css">
    <link rel="stylesheet" href="/public/admin/css/admin.css">
</head>
<body>
    <header class="admin-header">
        <div class="header-inner">
            <a href="/admin/dashboard">
                <img
                    src="https://charth.vtexassets.com/assets/vtex/assets-builder/charth.store/1.1.133/img/logo-charth___cdf0830626d6b6c0798360d0e9cf8d7e.png"
                    alt="Charth"
                    class="header-logo"
                >
            </a>
            <nav class="header-nav">
                <a href="/admin/dashboard" class="nav-link">Documentos</a>
                <a href="/admin/logs" class="nav-link">Logs</a>
                <form method="POST" action="/admin/logout" style="display:inline;">
                    <button type="submit" class="btn-outline-sm">Sair</button>
                </form>
            </nav>
        </div>
    </header>

    <main class="admin-main">
        <div class="page-title-row">
            <a href="/admin/dashboard" class="back-link">&#8592; Documentos</a>
            <h2><%= doc.title %></h2>
        </div>

        <!-- Document Info -->
        <div class="card mb-24">
            <div class="card-header card-header-flex">
                <h3>Informações do Documento</h3>
                <div class="card-header-actions">
                    <form method="POST" action="/admin/documents/<%= doc.id %>/toggle" style="display:inline;">
                        <button type="submit" class="btn btn-sm <%= doc.is_active ? 'btn-warning' : 'btn-success' %>">
                            <%= doc.is_active ? 'Desativar' : 'Ativar' %>
                        </button>
                    </form>
                    <form method="POST" action="/admin/documents/<%= doc.id %>/delete" style="display:inline;" class="confirm-delete" data-message="Excluir este documento permanentemente?">
                        <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                    </form>
                </div>
            </div>
            <div class="card-body">
                <dl class="info-grid">
                    <dt>ID</dt><dd>#<%= doc.id %></dd>
                    <dt>Título</dt><dd><%= doc.title %></dd>
                    <dt>Arquivo</dt><dd><%= doc.original_filename %></dd>
                    <dt>Tamanho</dt><dd><%= (doc.file_size / 1024 / 1024).toFixed(2) %> MB</dd>
                    <dt>Páginas</dt><dd><%= doc.page_count || '—' %></dd>
                    <dt>Upload em</dt><dd><%= doc.uploaded_at.slice(0, 16).replace('T', ' ') %></dd>
                    <dt>Status</dt>
                    <dd>
                        <% if (doc.is_active) { %>
                            <span class="badge badge-success">Ativo</span>
                        <% } else { %>
                            <span class="badge badge-danger">Inativo</span>
                        <% } %>
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mb-24" data-image-status="/admin/documents/<%= doc.id %>/images/status">
            <div class="card-header"><h3>Preparação das imagens</h3></div>
            <div class="card-body">
                <p id="image-preparation-summary" role="status">Consultando preparação…</p>
                <p class="text-sm text-muted">Os acessos passam a usar imagens quando todas as páginas e o zoom estiverem prontos. Durante a preparação, continuam disponíveis em PDF.</p>
                <form method="POST" action="/admin/documents/<%= doc.id %>/images/prepare">
                    <button type="submit" class="btn btn-sm btn-secondary">Retomar preparação</button>
                </form>
            </div>
        </div>

        <!-- Create New Link -->
        <div class="card mb-24">
            <div class="card-header">
                <h3>Criar Novo Acesso</h3>
            </div>
            <div class="card-body">
                <% if (typeof linkError !== 'undefined' && linkError) { %>
                    <div class="alert alert-error"><%= linkError %></div>
                <% } %>
                <form method="POST" action="/admin/documents/<%= doc.id %>/links" class="link-form">
                    <div class="form-row">
                        <div class="form-group flex-1">
                            <label for="recipient_name">Nome do Destinatário *</label>
                            <input type="text" id="recipient_name" name="recipient_name" class="form-control" required placeholder="Ex: João Silva">
                        </div>
                        <div class="form-group flex-1">
                            <label for="recipient_email">E-mail (opcional)</label>
                            <input type="email" id="recipient_email" name="recipient_email" class="form-control" placeholder="joao@exemplo.com">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group flex-1">
                            <label for="password">Senha de Acesso *</label>
                            <input type="text" id="password" name="password" class="form-control" required placeholder="Mínimo 4 caracteres">
                        </div>
                        <div class="form-group">
                            <label for="max_views">Máx. Visualizações</label>
                            <input type="number" id="max_views" name="max_views" class="form-control" min="1" placeholder="Ilimitado">
                        </div>
                        <div class="form-group">
                            <label for="expires_at">Expira em (Brasília)</label>
                            <input type="datetime-local" id="expires_at" name="expires_at" class="form-control">
                        </div>
                        <div class="form-group align-bottom">
                            <button type="submit" class="btn btn-primary">Criar Acesso</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Links Table -->
        <div class="card" id="access-links">
            <div class="card-header">
                <h3>Acessos Criados (<%= links.length %>)</h3>
            </div>
            <div class="card-body p-0">
                <% if (typeof linkUpdated !== 'undefined' && linkUpdated) { %>
                    <div class="alert alert-success" role="status">Limites do acesso atualizados.</div>
                <% } %>
                <% if (links.length === 0) { %>
                    <p class="empty-state">Nenhum acesso criado ainda.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Destinatário</th>
                                    <th>E-mail</th>
                                    <th>Versão</th>
                                    <th>Link</th>
                                    <th>Views</th>
                                    <th>Expira em</th>
                                    <th>Status</th>
                                    <th>Criado em</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% links.forEach(link => { %>
                                    <% const linkUrl = baseUrl + '/v/' + link.token; %>
                                    <% const editing = typeof editError !== 'undefined' && editError.id === link.id; %>
                                    <tr class="<%= link.is_active ? '' : 'row-inactive' %>">
                                        <td><strong><%= link.recipient_name %></strong></td>
                                        <td class="text-sm text-muted"><%= link.recipient_email || '—' %></td>
                                        <td class="text-sm">
                                            <strong class="access-code">2027_<%= link.version_code %></strong>
                                            <% if (link.access_code) { %>
                                                <div class="text-muted">Anterior: <%= link.access_code %></div>
                                            <% } %>
                                        </td>
                                        <td class="text-sm">
                                            <span class="link-truncate" title="<%= linkUrl %>">
                                                <%= link.token.slice(0, 12) %>...
                                            </span>
                                            <button
                                                class="btn btn-xs btn-secondary copy-link-btn"
                                                data-url="<%= linkUrl %>"
                                            >Copiar</button>
                                        </td>
                                        <td>
                                            <%= link.views_count %>
                                            <% if (link.max_views) { %>/ <%= link.max_views %><% } %>
                                        </td>
                                        <td class="text-sm">
                                            <% if (link.expires_at) { %>
                                                <%= expiryInput(link.expires_at).replace('T', ' ') %>
                                                <span class="text-muted">(Brasília)</span>
                                            <% } else { %>—<% } %>
                                        </td>
                                        <td>
                                            <% if (link.is_active) { %>
                                                <span class="badge badge-success">Ativo</span>
                                            <% } else { %>
                                                <span class="badge badge-danger">Inativo</span>
                                            <% } %>
                                        </td>
                                        <td class="text-sm"><%= link.created_at.slice(0, 16).replace('T', ' ') %></td>
                                        <td class="actions-cell">
                                            <a class="btn btn-xs btn-secondary" href="/admin/links/<%= link.id %>/preview">Testar imagens</a>
                                            <span class="text-sm text-muted image-link-status" data-link-id="<%= link.id %>"></span>
                                            <form method="POST" action="/admin/links/<%= link.id %>/images/prepare" style="display:inline;">
                                                <button type="submit" class="btn btn-xs btn-secondary">Priorizar imagens</button>
                                            </form>
                                            <button type="button" class="btn btn-xs btn-secondary edit-link-btn"
                                                data-target="edit-link-<%= link.id %>" aria-controls="edit-link-<%= link.id %>"
                                                aria-expanded="<%= editing ? 'true' : 'false' %>">Editar limites</button>
                                            <form method="POST" action="/admin/links/<%= link.id %>/toggle" style="display:inline;">
                                                <button type="submit" class="btn btn-xs <%= link.is_active ? 'btn-warning' : 'btn-success' %>">
                                                    <%= link.is_active ? 'Desativar' : 'Ativar' %>
                                                </button>
                                            </form>
                                            <form method="POST" action="/admin/links/<%= link.id %>/delete" style="display:inline;" class="confirm-delete" data-message="Remover este acesso permanentemente?">
                                                <button type="submit" class="btn btn-xs btn-danger">Remover</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <tr id="edit-link-<%= link.id %>" class="link-edit-row" <%= editing ? '' : 'hidden' %>>
                                        <td colspan="9">
                                            <form method="POST" action="/admin/links/<%= link.id %>/limits" class="edit-link-form">
                                                <p><strong>Editar acesso de <%= link.recipient_name %></strong></p>
                                                <% if (editing) { %>
                                                    <div class="alert alert-error" role="alert"><%= editError.message %></div>
                                                <% } %>
                                                <div class="form-row">
                                                    <div class="form-group">
                                                        <label for="edit-max-<%= link.id %>">Máx. visualizações</label>
                                                        <input type="number" id="edit-max-<%= link.id %>" name="max_views"
                                                            class="form-control" min="1" step="1" placeholder="Ilimitado"
                                                            value="<%= editing ? editValues.max_views : (link.max_views || '') %>">
                                                    </div>
                                                    <div class="form-group">
                                                        <label for="edit-expires-<%= link.id %>">Expira em (Brasília)</label>
                                                        <input type="datetime-local" id="edit-expires-<%= link.id %>" name="expires_at"
                                                            class="form-control"
                                                            value="<%= editing ? editValues.expires_at : expiryInput(link.expires_at) %>">
                                                    </div>
                                                    <div class="form-group align-bottom">
                                                        <button type="submit" class="btn btn-primary">Salvar alterações</button>
                                                        <button type="button" class="btn btn-secondary cancel-edit-link"
                                                            data-target="edit-link-<%= link.id %>">Cancelar</button>
                                                    </div>
                                                </div>
                                                <p class="text-sm text-muted">Já utilizadas: <%= link.views_count %>. O limite é o total, incluindo as visualizações já realizadas.
                                                    Deixe os campos vazios para remover o limite ou a expiração. O link e a senha permanecem os mesmos.</p>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <div id="toast" class="toast hidden">Link copiado!</div>

    <script src="/public/admin/js/admin.js"></script>
    <script src="/public/admin/js/image-preparation.js"></script>
</body>
</html>
