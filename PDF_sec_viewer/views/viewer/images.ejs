<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | CHARTH</title>
    <link rel="stylesheet" href="/public/admin/css/image-preview.css">
    <script src="/public/admin/js/image-preview.js" defer></script>
</head>
<body class="customer-viewer">
    <header class="test-header">
        <div class="test-heading"><strong class="brand">CHARTH</strong><span class="document-title" title="<%= title %>"><%= title %></span></div>
        <nav class="test-tools" aria-label="Controles de visualização">
            <div class="page-controls">
                <button id="previous" aria-label="Página anterior" disabled>&#8592;</button>
                <label for="page-number" class="sr-only">Página</label>
                <input id="page-number" type="number" min="1" value="1" inputmode="numeric">
                <span>/ <span id="page-total"><%= pageCount %></span></span>
                <button id="next" aria-label="Próxima página" disabled>&#8594;</button>
            </div>
            <div class="zoom-controls">
                <button id="zoom-out" aria-label="Reduzir zoom">−</button>
                <select id="zoom-value" aria-label="Tamanho de visualização">
                    <% for (let percent = 25; percent <= 300; percent += 5) { %>
                        <option value="<%= percent %>" <%= percent === 65 ? 'selected' : '' %>><%= percent %>%</option>
                    <% } %>
                </select>
                <button id="zoom-in" aria-label="Aumentar zoom">+</button>
                <button id="fit" title="Encaixar a página inteira na tela">Ajustar</button>
            </div>
        </nav>
    </header>
    <div class="preview-viewport">
        <main id="preview" data-prefix="/api/images/<%= token %>" data-mode="images" data-page="1" data-customer="true" aria-label="Lookbook" aria-busy="true">
            <img id="page-image" class="page-surface" alt="Página do lookbook" draggable="false" hidden>
            <canvas id="page-canvas" hidden></canvas>
        </main>
        <div id="page-status">
            <div id="message" role="status" aria-live="polite">Carregando página…</div>
            <button id="retry" hidden>Tentar novamente</button>
        </div>
    </div>
    <div hidden aria-hidden="true">
        <a id="mode-images"></a><a id="mode-pdf"></a><button id="repeat"></button>
        <span id="first-time"></span><span id="page-time"></span><span id="asset-details"></span><span id="cache-details"></span>
    </div>
</body>
</html>
